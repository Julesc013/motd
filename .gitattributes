# Source and generated text hashes must survive checkout on different hosts.
* text=auto eol=lf

# Retain original imports and raw terminal evidence byte for byte. CR/LF and
# padding in a terminal transcript are data, not formatting to normalize.
reference/** -text
*.ansi binary
*.png binary
# These two files are unmodified native Windows CI artifacts. Their CRLF bytes
# and UTF-8 BOM are covered by the retained archive/file hashes.
build/verification-powershell2-v04.xml -text
build/verification-powershell2-v04-probe.json -text
